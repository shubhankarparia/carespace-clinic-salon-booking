
# ==========================================
# CARESPACE BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment
NODE_ENV=development

# Server Configuration
PORT=5001
HOST=0.0.0.0

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/carespace

# MongoDB Atlas example
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/carespace?retryWrites=true&w=majority

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# React + Vite frontend
CLIENT_URL=http://localhost:5173

# Multiple frontend URLs can be separated by commas
# CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# ==========================================
# JWT AUTHENTICATION
# ==========================================

# Use a strong random secret of at least 32 characters
JWT_SECRET=68b3054813706673e687956389cf41d7a6288ef73c3d3257b805baab078dbac05d55a3a84727d70ad80011e9da2af3bf

# Token expiration
JWT_EXPIRES_IN=7d

# Password reset token expiration
JWT_RESET_EXPIRES_IN=15m

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

# SMTP provider
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false

# Gmail account
MAIL_USER=your_email@gmail.com

# Gmail App Password (not your normal Gmail password)
MAIL_PASSWORD=your_gmail_app_password

# Sender details
MAIL_FROM_NAME=CareSpace
MAIL_FROM_EMAIL=your_email@gmail.com

# ==========================================
# CLOUDINARY CONFIGURATION
# ==========================================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# BUSINESS CONFIGURATION
# ==========================================

BUSINESS_NAME=CareSpace Clinic & Salon
BUSINESS_EMAIL=support@example.com
BUSINESS_PHONE=+910000000000

# Currency
CURRENCY=INR

# Business timezone
TIMEZONE=Asia/Kolkata

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================

MAX_FILE_SIZE=5242880

# Allowed upload types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ==========================================
# SECURITY CONFIGURATION
# ==========================================

# API rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=debug
